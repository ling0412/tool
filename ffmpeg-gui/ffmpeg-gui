    def _generate_encoding_command(self):
        command = ["ffmpeg", "-hide_banner", "-y"]
        
        input_path = self.input_path_input.text().strip()
        extra_input = self.extra_input_input.text().strip()
        is_audio_only = self._is_audio_file(input_path)
        vcodec = self.vcodec_combo.currentText()
        spec = CODEC_SPEC.get(vcodec, {})
        is_vaapi = spec.get("type") == "vaapi"
        is_no_audio = spec.get("no_audio", False)
        is_palette = spec.get("palette", False)
        
        # VAAPI 设备
        vaapi_active = is_vaapi and not is_audio_only
        if vaapi_active:
            vaapi_device = self.vaapi_device_input.text().strip()
            if vaapi_device:
                command.extend(["-vaapi_device", vaapi_device])
        
        # 输入文件
        if input_path:
            command.extend(["-i", input_path])
        if extra_input:
            command.extend(["-i", extra_input])
        
        # 视频滤镜
        scale_w = self.scale_width_input.value()
        scale_h = self.scale_height_input.value()
        has_scale = scale_w > 0 or scale_h > 0
        
        linear_vf = []
        if has_scale:
            if scale_w > 0 and scale_h > 0:
                linear_vf.append(f"scale={scale_w}:{scale_h}:force_original_aspect_ratio=decrease,pad=ceil(iw/2)*2:ceil(ih/2)*2")
            elif scale_w > 0:
                linear_vf.append(f"scale={scale_w}:-2")
            else:
                linear_vf.append(f"scale=-2:{scale_h}")
        
        fps = self.fps_input.value()
        if fps > 0:
            linear_vf.append(f"fps={fps}")
        
        if is_palette:
            colors = self.crf_input.value()
            prefix = ",".join(linear_vf)
            vf_filter = f"{prefix},split[s0][s1];[s0]palettegen=max_colors={colors}[p];[s1][p]paletteuse" if prefix else \
                       f"split[s0][s1];[s0]palettegen=max_colors={colors}[p];[s1][p]paletteuse"
            command.extend(["-vf", vf_filter])
        else:
            vf_parts = list(linear_vf)
            if vaapi_active:
                vf_parts.append("format=nv12,hwupload")
            if vf_parts:
                command.extend(["-vf", ",".join(vf_parts)])
        
        # 视频编码参数
        if not is_audio_only and spec.get("type") != "copy":
            command.extend(["-c:v", vcodec])
            
            rc_modes = spec.get("rc_modes", {})
            mode_data = rc_modes.get(self.rc_mode_combo.currentText()) if rc_modes else None
            
            if mode_data:
                self._add_rc_params(command, spec, mode_data)
            
            if spec.get("loop"):
                command.extend(["-loop", "0"])
            
            if spec.get("presets"):
                self._add_preset_params(command, spec)
        
        elif spec.get("type") == "copy" and not is_audio_only:
            command.extend(["-c:v", "copy"])
        
        # 音频编码参数
        if is_no_audio and not is_audio_only:
            command.extend(["-an"])
        else:
            acodec = self.acodec_combo.currentText()
            if acodec:
                command.extend(["-c:a", acodec])
                audio_bitrate = self.audio_bitrate_input.value()
                if audio_bitrate > 0 and acodec != "copy":
                    command.extend(["-b:a", f"{audio_bitrate}k"])
        
        # 线程数
        threads = self.threads_input.value()
        if threads > 0:
            command.extend(["-threads", str(threads)])
        
        # 额外参数
        extra_args = self.extra_args_input.text().strip()
        self._extra_args_error = None
        if extra_args:
            try:
                parsed = shlex.split(extra_args)
                if is_no_audio:
                    filtered = []
                    i = 0
                    while i < len(parsed):
                        arg = parsed[i]
                        if arg == "-map" and i + 1 < len(parsed) and ":a" in parsed[i+1]:
                            i += 2
                            continue
                        filtered.append(arg)
                        i += 1
                    command.extend(filtered)
                else:
                    command.extend(parsed)
            except ValueError:
                self._extra_args_error = extra_args
        
        output_path = self.output_path_input.text().strip()
        if output_path:
            command.append(output_path)
        
        return [part for part in command if part]
    
    def _add_rc_params(self, command, spec, mode_data):
        rc_mode = mode_data.get("rc_mode", "")
        params = mode_data.get("params", [])
        is_vaapi = spec.get("type") == "vaapi"
        
        if is_vaapi:
            if rc_mode:
                command.extend(["-rc_mode", rc_mode])
            
            for param in params:
                if param in ["qp_p", "qp_icq"]:
                    vcodec = self.vcodec_combo.currentText()
                    qp_param = VAAPI_QUALITY_CONFIG.get(vcodec, {}).get("param", "-qp")
                    command.extend([qp_param, str(self.qp_input.value())])
                    if qp_param == "-q:v":
                        command.extend(["-qmin", "0", "-qmax", "255"])
                elif param == "bitrate":
                    bitrate = self.bitrate_input.value()
                    command.extend(["-b:v", f"{bitrate}k"])
                    command.extend(["-maxrate", f"{int(bitrate * 1.2)}k"])
        else:
            if "crf" in params:
                command.extend(["-crf", str(self.crf_input.value())])
                for flag, val in spec.get("crf_extras", []):
                    command.extend([flag, val])
            if "quality" in params:
                command.extend(["-quality", str(self.crf_input.value())])
            if rc_mode == "lossless":
                command.extend(["-lossless", "1"])
            if "bitrate" in params:
                command.extend(["-b:v", f"{self.bitrate_input.value()}k"])
    
    def _add_preset_params(self, command, spec):
        preset_label = self.quality_preset_combo.currentText()
        if not preset_label or "N/A" in preset_label:
            return
        
        presets = spec.get("presets", {})
        preset_value = presets.get(preset_label)
        if preset_value is None:
            return
        
        flag = spec.get("preset_flag", "-preset")
        if spec.get("preset_num"):
            command.extend([flag, str(preset_value)])
        else:
            command.extend([flag, preset_value])
    
    def _generate_metrics_command(self):
        """生成质量分析命令"""
        ref_path = self.ref_path_input.text().strip()
        dist_path = self.distorted_path_input.text().strip()
        
        if not ref_path or not dist_path:
            return ["echo", "错误: 请指定参考文件和失真文件"]
        
        filter_parts = []
        if self.vmaf_checkbox.isChecked():
            log_dir = os.path.dirname(os.path.abspath(dist_path))
            log_name = os.path.splitext(os.path.basename(dist_path))[0]
            log_path = os.path.join(log_dir, f"vmaf_{log_name}.json")
            filter_parts.append(
                f"libvmaf=log_path='{log_path}':log_fmt=json")
        if self.psnr_checkbox.isChecked():
            filter_parts.append("psnr")
        if self.ssim_checkbox.isChecked():
            filter_parts.append("ssim")
        
        if not filter_parts:
            return ["echo", "错误: 请至少选择一个质量指标"]
        
        filter_complex = ";".join([f"[0:v][1:v]{f}" for f in filter_parts])
        
        return [
            "ffmpeg", "-hide_banner",
            "-i", dist_path,
            "-i", ref_path,
            "-lavfi", filter_complex,
            "-f", "null", "-"
        ]
    
    def _generate_image_command(self):
        """生成图片转码命令"""
        command = ["ffmpeg", "-hide_banner", "-y"]
        
        input_path = self.img_input_path.text().strip()
        output_path = self.img_output_path.text().strip()
        img_format = self.img_format_combo.currentText()
        self._last_image_output = output_path
        
        if not input_path or not output_path:
            return ["echo", "错误: 请指定输入和输出图片路径"]
        
        scale_w = self.img_scale_width.value()
        scale_h = self.img_scale_height.value()
        has_scale = scale_w > 0 or scale_h > 0
        use_white_fill = (img_format == "JPG" and 
                          self.img_white_fill.isChecked())

        # AVIF: JPEG/PNG 无缩放 → avifenc 直通
        if img_format == "AVIF":
            is_direct = input_path.lower().endswith(('.jpg', '.jpeg', '.png'))
            if is_direct and not has_scale:
                return ["avifenc", input_path, output_path,
                        "-q", str(self.img_quality_input.value()),
                        "-s", "6"]

        # JXL 输入 → djxl 无损提取
        if self.img_djxl.isVisible() and self.img_djxl.isChecked():
            return ["djxl", input_path, output_path]

        command.extend(["-i", input_path])
        
        # 构建缩放字符串
        scale_str = ""
        if has_scale:
            if scale_w > 0 and scale_h > 0:
                scale_str = f"scale={scale_w}:{scale_h}"
            elif scale_w > 0:
                scale_str = f"scale={scale_w}:-2"
            else:
                scale_str = f"scale=-2:{scale_h}"
        
        # 构建滤镜
        # JPG/AVIF 需要 yuv420p 色彩空间且宽高为偶数
        yuv_fmt = "format=yuv420p10le" if img_format == "AVIF" else "format=yuv420p"
        needs_even = img_format in ("JPG", "AVIF")
        even_pad = ",pad=ceil(iw/2)*2:ceil(ih/2)*2"
        
        if use_white_fill:
            if has_scale:
                filter_str = (f"[0:v]{scale_str}[s];"
                             f"[s]split[a][b];"
                             f"[a]drawbox=c=white:t=fill[bg];"
                             f"[bg][b]overlay,{yuv_fmt}{even_pad}")
            else:
                filter_str = ("[0:v]split[a][b];"
                             "[a]drawbox=c=white:t=fill[bg];"
                             f"[bg][b]overlay,{yuv_fmt}{even_pad}")
            command.extend(["-filter_complex", filter_str])
        elif has_scale:
            vf = scale_str
            if needs_even:
                vf += f",{yuv_fmt}{even_pad}"
            command.extend(["-vf", vf])
        elif needs_even:
            command.extend(["-vf", f"{yuv_fmt}{even_pad}"])
        
        # 格式特定编码参数
        if img_format == "JPG":
            command.extend(["-q:v", str(self.img_quality_input.value())])
        elif img_format == "PNG":
            command.extend(["-compression_level", 
                           str(self.img_quality_input.value())])
        elif img_format == "WebP":
            command.extend(["-c:v", "libwebp", "-quality",
                           str(self.img_quality_input.value())])
        elif img_format == "AVIF":
            crf = round((100 - self.img_quality_input.value()) * 63 / 100)
            command.extend([
                "-c:v", "libsvtav1",
                "-crf", str(crf),
                "-preset", "6",
                "-pix_fmt", "yuv420p10le",
                "-svtav1-params", "keyint=1"
            ])
        elif img_format == "JXL":
            is_direct = input_path.lower().endswith(
                ('.jpg', '.jpeg', '.png', '.gif', '.bmp'))
            if is_direct and not has_scale:
                d = self.img_quality_input.value()
                if d == 0:
                    is_jpeg = input_path.lower().endswith(('.jpg', '.jpeg'))
                    if is_jpeg:
                        return ["cjxl", input_path, output_path,
                                "-d", "0", "-j", "1"]
                    else:
                        return ["cjxl", input_path, output_path,
                                "-d", "0"]
                else:
                    return ["cjxl", input_path, output_path,
                            "-d", str(d)]
            command.extend(["-c:v", "libjxl", "-distance",
                            str(self.img_quality_input.value())])
        # BMP / TIFF: 无需编码参数
        
        command.append(output_path)
        return command
    
    def _generate_cover_command(self):
        """生成封面操作命令"""
        command = ["ffmpeg", "-hide_banner", "-y"]

        video_path = self.cover_video_path.text().strip()
        cover_path = self.cover_image_path.text().strip()
        mode = self.cover_mode_combo.currentText()
        output_path = self.cover_output_path.text().strip()
        
        if not video_path:
            return ["echo", "错误: 请指定视频文件路径"]
        
        ext = os.path.splitext(video_path.lower())[1]
        is_mkv = ext in [".mkv", ".mk3d"]
        
        if mode == "添加/替换封面":
            if not cover_path:
                return ["echo", "错误: 请指定封面图片路径"]
            if not output_path:
                return ["echo", "错误: 请指定输出文件路径"]
            
            if is_mkv:
                command.extend(["-i", video_path])
                cover_ext = os.path.splitext(cover_path.lower())[1]
                mime_type = COVER_MIME_MAP.get(cover_ext, "image/jpeg")
                command.extend([
                    "-attach", cover_path,
                    "-metadata:s:t", f"mimetype={mime_type}",
                    "-metadata:s:t", f"filename=cover{cover_ext}",
                    "-c", "copy"
                ])
            else:
                command.extend(["-i", video_path, "-i", cover_path])
                command.extend([
                    "-map", "0", "-map", "1",
                    "-c", "copy",
                    "-disposition:v:1", "attached_pic"
                ])
            
            command.append(output_path)
        
        elif mode == "提取封面":
            if not output_path:
                return ["echo", "错误: 请指定输出封面图片路径"]
            
            if is_mkv:
                command.extend([
                    f"-dump_attachment:t:0={output_path}",
                    "-i", video_path,
                    "-f", "null", "-"
                ])
            else:
                command.extend([
                    "-i", video_path, "-map", "0:disp:attached_pic",
                    "-c", "copy", output_path
                ])
        
        elif mode == "移除封面":
            if not output_path:
                return ["echo", "错误: 请指定输出文件路径"]
            
            command.extend(["-i", video_path])
            
            if is_mkv:
                command.extend(["-map", "0", "-map", "-0:t?", "-c", "copy"])
            else:
                command.extend([
                    "-map", "0", "-map", "-0:disp:attached_pic",
                    "-c", "copy"
                ])
            
            command.append(output_path)
        
        return command
    
    def _generate_trim_command(self):
        """生成视频裁剪命令"""
        command = ["ffmpeg", "-hide_banner", "-y"]

        input_path = self.trim_input_path.text().strip()
        output_path = self.trim_output_path.text().strip()

        if not input_path or not output_path:
            return ["echo", "错误: 请指定输入和输出文件路径"]

        start = self.trim_start.text().strip()
        end = self.trim_end.text().strip()
        duration = self.trim_duration.text().strip()

        if start:
            command.extend(["-ss", start])

        if end:
            command.extend(["-to", end])
        elif duration:
            command.extend(["-t", duration])

        command.extend(["-i", input_path, "-c", "copy",
                        "-avoid_negative_ts", "make_zero"])

        command.append(output_path)
        return command
    
