    def _show_ffprobe_details(self):
        """显示媒体文件详细信息（ffprobe + mediainfo）"""
        input_path = self.input_path_input.text().strip()
        
        if not input_path:
            QMessageBox.warning(self, "警告", "请先指定一个输入文件路径。")
            return
        
        ffprobe_output = ""
        mediainfo_output = ""
        
        # ffprobe
        ffprobe_cmd = [
            "ffprobe", "-v", "quiet", "-print_format", "json",
            "-show_format", "-show_streams", input_path
        ]
        try:
            result = subprocess.run(
                ffprobe_cmd, capture_output=True, text=True,
                check=True, encoding='utf-8'
            )
            try:
                data = json.loads(result.stdout)
                ffprobe_output = json.dumps(data, indent=4, ensure_ascii=False)
            except json.JSONDecodeError:
                ffprobe_output = f"FFprobe 原始输出:\n\n{result.stdout}"
        except subprocess.CalledProcessError as e:
            ffprobe_output = f"FFprobe 失败:\n\n{e.stderr.strip()}"
        except FileNotFoundError:
            ffprobe_output = "找不到 'ffprobe' 命令。请确保 FFmpeg 已安装。"
        except Exception as e:
            ffprobe_output = f"FFprobe 发生意外错误: {e}"
        
        # mediainfo
        try:
            result = subprocess.run(
                ["mediainfo", input_path],
                capture_output=True, text=True, encoding='utf-8'
            )
            if result.returncode != 0:
                mediainfo_output = f"MediaInfo 返回错误 (退出码 {result.returncode}):\n\n{result.stderr.strip() or result.stdout.strip()}"
            else:
                mediainfo_output = result.stdout.strip() or "(无输出)"
        except FileNotFoundError:
            mediainfo_output = "mediainfo 未安装或不可用。"
        except Exception as e:
            mediainfo_output = f"MediaInfo 发生意外错误: {e}"
        
        dialog = FFprobeDetailsDialog(self)
        dialog.set_ffprobe_content(ffprobe_output)
        dialog.set_mediainfo_content(mediainfo_output)
        dialog.exec()
    
