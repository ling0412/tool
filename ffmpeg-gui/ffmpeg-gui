    def _is_audio_file(self, path):
        """判断是否为纯音频文件"""
        if not path:
            return False
        ext = os.path.splitext(path.lower())[1]
        return ext in AUDIO_EXTENSIONS
    
    def _open_file_dialog(self, line_edit, is_save_dialog=False, file_filter=None):
        """打开文件对话框"""
        if file_filter is None:
            file_filter = ("Video Files (*.mp4 *.mkv *.avi *.webm);;"
                          "Audio Files (*.mp3 *.aac *.flac *.wav *.m4a);;"
                          "Subtitle Files (*.srt *.ass *.ssa);;"
                          "All Files (*.*)")
        
        if is_save_dialog:
            path, _ = QFileDialog.getSaveFileName(
                self, "保存文件为", line_edit.text(), file_filter)
        else:
            path, _ = QFileDialog.getOpenFileName(
                self, "选择文件", line_edit.text(), file_filter)
        
        if path:
            path = os.path.abspath(path)
            line_edit.setText(path)
            if line_edit == self.input_path_input:
                self._update_output_path(path)
            if line_edit in [self.img_input_path, self.img_output_path]:
                self._update_image_preview()
            if line_edit == self.cover_video_path:
                self._update_cover_output_path()
                self._update_cover_preview()
            if line_edit == self.cover_image_path:
                self._update_cover_preview()
            if line_edit == self.cover_output_path:
                self._update_cover_preview()
    
    def _update_output_path(self, input_path=None):
        if input_path is None:
            input_path = self.input_path_input.text()
        if not input_path:
            self.output_path_input.setText("output.mp4")
            return
        
        dir_name = os.path.dirname(os.path.abspath(input_path))
        base_name = os.path.splitext(os.path.basename(input_path))[0]
        
        if self._is_audio_file(input_path):
            target_ext = _AUDIO_EXT_MAP.get(self.acodec_combo.currentText(), ".mp3")
        else:
            target_ext = CODEC_SPEC.get(self.vcodec_combo.currentText(), {}).get("ext", ".mp4")
        
        self.output_path_input.setText(os.path.join(dir_name, f"{base_name}_encoded{target_ext}"))
    
    def _copy_command(self, command_list):
        """将命令列表复制到剪贴板"""
        clipboard = QApplication.clipboard()
        command_str = " ".join(shlex.quote(p) for p in command_list)
        clipboard.setText(command_str)
        QMessageBox.information(self, "成功", "命令已复制到剪贴板")
    
    # ===========================
    # 事件处理器
    # ===========================
    
    def _handle_input_path_change(self, path):
        """处理输入文件路径变化"""
        is_audio_only = self._is_audio_file(path)
        
        # 控制 ffprobe 按钮
        self.ffprobe_btn.setEnabled(bool(path.strip()))
        
        # 控制视频相关选项
        self._set_video_options_enabled(not is_audio_only)
        
        if path.strip():
            self._update_output_path(path)
        
        self._update_encoding_preview()
    
    def _set_video_options_enabled(self, enabled):
        """启用或禁用视频相关控件"""
        self.vcodec_combo.setEnabled(enabled)
        self.vcodec_label.setEnabled(enabled)
        self.rc_mode_combo.setEnabled(enabled)
        self.rc_mode_label.setEnabled(enabled)
        self.rc_params_widget.setEnabled(enabled)
        self.quality_preset_combo.setEnabled(enabled)
        self.quality_preset_label.setEnabled(enabled)
        self.vaapi_label.setEnabled(enabled)
        self.scale_width_label.setEnabled(enabled)
        self.scale_width_input.setEnabled(enabled)
        self.scale_height_input.setEnabled(enabled)
        self.fps_label.setEnabled(enabled)
        self.fps_input.setEnabled(enabled)
        self.vaapi_device_input.setEnabled(enabled)
        
        if not enabled:
            self.acodec_combo.setEnabled(True)
            self.acodec_label.setEnabled(True)
            self.audio_bitrate_input.setEnabled(True)
            self.audio_bitrate_label.setEnabled(True)
        else:
            self._handle_vcodec_change(self.vcodec_combo.currentText())
    
    def _handle_vcodec_change(self, vcodec):
        if not self.vcodec_combo.isEnabled():
            return
        
        spec = CODEC_SPEC.get(vcodec, {})
        spec_type = spec.get("type", "")
        is_vaapi = spec_type == "vaapi"
        
        # VAAPI 设备
        self.vaapi_device_input.setEnabled(is_vaapi)
        
        # 无音频编码器禁用音频控件
        is_no_audio = spec.get("no_audio", False)
        self.acodec_combo.setEnabled(not is_no_audio)
        self.acodec_label.setEnabled(not is_no_audio)
        self.audio_bitrate_input.setEnabled(not is_no_audio)
        self.audio_bitrate_label.setEnabled(not is_no_audio)
        
        # CRF/质量/颜色范围
        crf_cfg = spec.get("crf")
        if crf_cfg:
            self.crf_input.setRange(crf_cfg[0], crf_cfg[1])
            self.crf_input.setValue(crf_cfg[2])
            label = spec.get("crf_label", f"CRF 值 ({crf_cfg[0]}-{crf_cfg[1]}):")
            self.crf_label.setText(label)
        
        # VAAPI QP 范围
        if vcodec in VAAPI_QUALITY_CONFIG:
            qc = VAAPI_QUALITY_CONFIG[vcodec]
            self.qp_input.setRange(qc["range"][0], qc["range"][1])
            self.qp_input.setValue(qc["default"])
        
        self._update_preset_options(vcodec, spec)
        self._update_rc_mode_options(vcodec, spec)
        
        if self.input_path_input.text().strip():
            self._update_output_path()
    
    def _update_preset_options(self, vcodec, spec):
        self.quality_preset_combo.blockSignals(True)
        self.quality_preset_combo.clear()
        
        presets = spec.get("presets")
        has_presets = presets is not None
        
        self.quality_preset_combo.setEnabled(has_presets)
        self.quality_preset_label.setEnabled(has_presets)
        
        if has_presets:
            self.quality_preset_combo.addItems(presets.keys())
            self.quality_preset_combo.setCurrentText(spec.get("preset_default", ""))
            self.quality_preset_label.setText(spec.get("preset_label", "编码预设:"))
        else:
            self.quality_preset_combo.addItem("N/A")
        
        self.quality_preset_combo.blockSignals(False)
    
    def _update_rc_mode_options(self, vcodec, spec):
        self.rc_mode_combo.blockSignals(True)
        self.rc_mode_combo.clear()
        
        is_audio = self._is_audio_file(self.input_path_input.text())
        rc_modes = spec.get("rc_modes")
        has_rc = rc_modes is not None and spec.get("type") != "copy"
        
        self.rc_mode_combo.setEnabled(has_rc and not is_audio)
        
        if has_rc:
            self.rc_mode_label.setText(spec.get("rc_label", "码率控制:"))
            for label in rc_modes.keys():
                self.rc_mode_combo.addItem(label)
            self.rc_mode_combo.setCurrentIndex(0)
        else:
            self.rc_mode_combo.addItem("N/A")
        
        self.rc_mode_combo.blockSignals(False)
        self._handle_rc_mode_change(self.rc_mode_combo.currentText(), spec)
    
    def _handle_rc_mode_change(self, mode_label, spec=None):
        for i in reversed(range(self.rc_params_layout.count())):
            widget = self.rc_params_layout.itemAt(i).widget()
            if widget:
                widget.setParent(None)
        
        if spec is None:
            vcodec = self.vcodec_combo.currentText()
            spec = CODEC_SPEC.get(vcodec, {})
        
        rc_modes = spec.get("rc_modes", {})
        mode_data = rc_modes.get(mode_label) if rc_modes else None
        
        if not mode_data:
            if spec.get("palette"):
                self.crf_label.setText(spec.get("crf_label", "最大颜色数 (2-256):"))
                self.rc_params_layout.addWidget(self.crf_label, 0, 0,
                                               Qt.AlignmentFlag.AlignRight)
                self.rc_params_layout.addWidget(self.crf_input, 0, 1,
                                               Qt.AlignmentFlag.AlignLeft)
                self.rc_params_layout.addItem(
                    QSpacerItem(20, 10, QSizePolicy.Policy.Minimum,
                               QSizePolicy.Policy.Expanding), 1, 0)
            self._update_encoding_preview()
            return
        
        params = mode_data.get("params", [])
        rc_mode = mode_data.get("rc_mode", "")
        row = 0
        
        if "crf" in params:
            self.rc_params_layout.addWidget(self.crf_label, row, 0, 
                                           Qt.AlignmentFlag.AlignRight)
            self.rc_params_layout.addWidget(self.crf_input, row, 1, 
                                           Qt.AlignmentFlag.AlignLeft)
            row += 1
        
        if "quality" in params:
            if rc_mode == "lossless":
                self.crf_label.setText("压缩等级 (-quality, 0-100, ↑越慢越小):")
                self.crf_input.setValue(75)
            else:
                self.crf_label.setText("画质 (-quality, 0-100, ↑越高越好):")
                self.crf_input.setValue(80)
            self.rc_params_layout.addWidget(self.crf_label, row, 0,
                                           Qt.AlignmentFlag.AlignRight)
            self.rc_params_layout.addWidget(self.crf_input, row, 1,
                                           Qt.AlignmentFlag.AlignLeft)
            row += 1
        
        if "qp_p" in params or "qp_icq" in params:
            vcodec = self.vcodec_combo.currentText()
            qc = VAAPI_QUALITY_CONFIG.get(vcodec, {})
            label_text = qc.get("label", "QP/ICQ 质量因子 (1-51):")
            self.qp_label.setText(label_text)
            self.rc_params_layout.addWidget(self.qp_label, row, 0, 
                                           Qt.AlignmentFlag.AlignRight)
            self.rc_params_layout.addWidget(self.qp_input, row, 1, 
                                           Qt.AlignmentFlag.AlignLeft)
            row += 1
        
        if "bitrate" in params:
            self.rc_params_layout.addWidget(self.bitrate_label, row, 0, 
                                           Qt.AlignmentFlag.AlignRight)
            self.rc_params_layout.addWidget(self.bitrate_input, row, 1, 
                                           Qt.AlignmentFlag.AlignLeft)
            row += 1
        
        if row > 0:
            self.rc_params_layout.addItem(
                QSpacerItem(20, 10, QSizePolicy.Policy.Minimum, 
                           QSizePolicy.Policy.Expanding), row, 0)
        
        self._update_encoding_preview()
    
    def _handle_image_format_change(self, fmt):
        """处理图片输出格式变化"""
        config = IMAGE_QUALITY_CONFIG.get(fmt, {})
        if config:
            self.img_quality_label.setText(config["label"])
            r = config["range"]
            self.img_quality_input.setRange(r[0], r[1])
            self.img_quality_input.setValue(config["default"])
            self.img_quality_label.setVisible(True)
            self.img_quality_input.setVisible(True)
        else:
            self.img_quality_label.setVisible(False)
            self.img_quality_input.setVisible(False)
        
        self.img_white_fill.setVisible(fmt == "JPG")
        self._update_djxl_visibility()
        self._update_image_output_path()
        self._update_image_preview()
    
    def _update_djxl_visibility(self):
        input_path = self.img_input_path.text().strip()
        fmt = self.img_format_combo.currentText()
        has_scale = (self.img_scale_width.value() > 0 or 
                     self.img_scale_height.value() > 0)
        
        is_jxl = input_path.lower().endswith('.jxl')
        is_png_jpg = fmt in ("PNG", "JPG")
        show = is_jxl and is_png_jpg and not has_scale
        
        self.img_djxl.setVisible(show)
        if not show:
            self.img_djxl.setChecked(False)
        
        if show and self.img_djxl.isChecked():
            self.img_quality_label.setVisible(False)
            self.img_quality_input.setVisible(False)
            self.img_white_fill.setVisible(False)
        else:
            config = IMAGE_QUALITY_CONFIG.get(fmt, {})
            has_cfg = bool(config)
            self.img_quality_label.setVisible(has_cfg)
            self.img_quality_input.setVisible(has_cfg)
            self.img_white_fill.setVisible(fmt == "JPG")
    
